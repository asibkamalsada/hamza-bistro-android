<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, trusting the certificates Android ships and none a user or
     an MDM profile added: a proxy that installed its own CA on the tablet
     does not get to read the session. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
